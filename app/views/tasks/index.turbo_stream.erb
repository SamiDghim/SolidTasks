<%= turbo_stream.replace "tasks-list" do %>
  <%= render partial: "task", collection: @tasks, as: :task %>
<% end %>
<%= turbo_stream.replace "new_task_form" do %>
  <%= render partial: "form", locals: { task: @task } %>
<% end %>
<% if flash[:alert] %>
  <%= turbo_stream.append "flash", partial: "shared/flash", locals: { alert: flash[:alert] } %>
<% end %>
